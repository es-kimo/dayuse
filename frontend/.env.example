# 카카오 로그인(OAuth 인가 요청)에 쓰는 REST API 키
VITE_KAKAO_CLIENT_ID=

# 카카오톡 공유(JavaScript SDK)에 쓰는 JavaScript 키.
# 위 REST API 키와 다른 값이다. 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키.
# 비워두면 카카오톡 공유 버튼이 네이티브 공유 시트/링크 복사로만 동작한다.
VITE_KAKAO_JAVASCRIPT_KEY=

# 백엔드 API 베이스 URL. 비우면 Vite 개발 프록시(/api/v1)를 쓴다.
VITE_API_BASE_URL=
